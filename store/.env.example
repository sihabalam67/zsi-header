# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
SITE_URL=https://your-domain.com

# Stripe (stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CJ Dropshipping (cjdropshipping.com → My CJ → Authorization → API)
CJ_API_KEY=
CJ_VID_WAND=        # variant ID of the fishing-rod toy (US warehouse listing)
CJ_VID_REFILL=      # variant ID of the lure refill pack
CJ_LOGISTIC_NAME=USPS+        # fallback only; the store picks the cheapest ≤5-day US method
CJ_MAX_SHIP_DAYS=5
CJ_PAY_TYPE=2       # try to pay from CJ wallet; if it is short, the order waits and you get an email

# Email (resend.com, free tier)
RESEND_API_KEY=
EMAIL_FROM="Indoor Hunt Co. <orders@your-domain.com>"
SUPPORT_EMAIL=support@your-domain.com
OWNER_EMAIL=you@example.com     # gets alerts when an automatic order fails
BUSINESS_ADDRESS="Street, City, State ZIP"

# Random string; Vercel sends it to the cron route automatically
CRON_SECRET=

# Admin dashboard (/admin)
ADMIN_PASSWORD=                 # choose a long password; you log in with it
ADMIN_SECRET=                   # optional: random string for signing the login cookie

# Search engines & AI visibility
GOOGLE_SITE_VERIFICATION=       # from Google Search Console (HTML tag method, content value only)
BING_SITE_VERIFICATION=         # from Bing Webmaster Tools (meta tag content value)
INDEXNOW_KEY=                   # random hex string; served at /indexnow.txt
SOCIAL_INSTAGRAM=               # https://www.instagram.com/yourhandle
SOCIAL_TIKTOK=                  # https://www.tiktok.com/@yourhandle
