# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
SITE_URL=https://your-domain.com

# Stripe (stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CJ Dropshipping (cjdropshipping.com → My CJ → Authorization → API)
CJ_API_KEY=
CJ_VID_WAND=        # variant ID of the fishing-rod toy (US warehouse listing)
CJ_VID_REFILL=      # variant ID of the lure refill pack
CJ_LOGISTIC_NAME=USPS+
CJ_PAY_TYPE=2       # pay from CJ wallet automatically; keep wallet funded

# Email (resend.com, free tier)
RESEND_API_KEY=
EMAIL_FROM="Indoor Hunt Co. <orders@your-domain.com>"
SUPPORT_EMAIL=support@your-domain.com
OWNER_EMAIL=you@example.com     # gets alerts when an automatic order fails
BUSINESS_ADDRESS="Street, City, State ZIP"

# Random string; Vercel sends it to the cron route automatically
CRON_SECRET=
